# Enables PostgreSQL Row-Level Security on tenant-owned tables, generated by
# `rails g tenant_kit:rls`. Rows are visible and writable only when the
# tenant_kit.tenant_id setting matches the tenant column<%= options[:bypass] ? ", or when tenant_kit.bypass is 'on' (TenantKit.without_tenant)" : "" %>.
# TenantKit sets these per connection when config.postgres_rls is true.
#
# Policies do not apply to superusers or roles with BYPASSRLS: run the app as
# an ordinary role. FORCE ROW LEVEL SECURITY makes them apply to the table
# owner too. See docs/POSTGRES_RLS.md.
class <%= rls_migration_class_name %> < ActiveRecord::Migration[<%= migration_version %>]
  def up
<% tables.each_with_index do |entry, index| -%>
<%= "\n" if index > 0 %>    execute <<~SQL
<% enable_sql(entry).each do |sql| -%>
      <%= sql %>;
<% end -%>
    SQL
<% end -%>
  end

  def down
<% tables.each_with_index do |entry, index| -%>
<%= "\n" if index > 0 %>    execute <<~SQL
<% disable_sql(entry).each do |sql| -%>
      <%= sql %>;
<% end -%>
    SQL
<% end -%>
  end
end
